<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Common theme attributes that apply to both light and dark modes -->
    <style name="Base.Theme.FlightStats.Common" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">?attr/isLightTheme</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">?attr/isLightTheme</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
    </style>

    <!-- Base application theme. -->
    <style name="Base.Theme.FlightStats" parent="Base.Theme.FlightStats.Common">
        <!-- Primary (Indigo) -->
        <item name="colorPrimary">#4F46E5</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#E0E7FF</item>
        <item name="colorOnPrimaryContainer">#312E81</item>

        <!-- Secondary (Sky Blue) -->
        <item name="colorSecondary">#0284C7</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#E0F2FE</item>
        <item name="colorOnSecondaryContainer">#0369A1</item>

        <!-- Tertiary (Amber) -->
        <item name="colorTertiary">#D97706</item>
        <item name="colorOnTertiary">#FFFFFF</item>
        <item name="colorTertiaryContainer">#FEF3C7</item>
        <item name="colorOnTertiaryContainer">#78350F</item>

        <!-- Neutral / Surface colors -->
        <item name="android:colorBackground">#F8FAFC</item>
        <item name="colorOnBackground">#0F172A</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#0F172A</item>
        <item name="colorSurfaceVariant">#F1F5F9</item>
        <item name="colorOnSurfaceVariant">#475569</item>
        <item name="colorOutline">#CBD5E1</item>
        <item name="colorOutlineVariant">#E2E8F0</item>

        <!-- Surface Container variants for M3 -->
        <item name="colorSurfaceContainer">#F1F5F9</item>
        <item name="colorSurfaceContainerLow">#F8FAFC</item>
        <item name="colorSurfaceContainerHigh">#E2E8F0</item>
        <item name="colorSurfaceContainerHighest">#CBD5E1</item>
    </style>

    <style name="Theme.FlightStats" parent="Base.Theme.FlightStats" />
</resources>