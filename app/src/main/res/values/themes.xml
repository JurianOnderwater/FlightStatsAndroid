<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Common theme attributes that apply to both light and dark modes -->
    <style name="Base.Theme.FlightStats.Common" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">?attr/isLightTheme</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">?attr/isLightTheme</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="fontFamily">@font/quicksand</item>
    </style>

    <!-- Base application theme. -->
    <style name="Base.Theme.FlightStats" parent="Base.Theme.FlightStats.Common">
        <!-- Primary (Dark Sage Green for readability, Willow Green for container) -->
        <item name="colorPrimary">#3A6B45</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#CCDDB7</item>
        <item name="colorOnPrimaryContainer">#272727</item>

        <!-- Secondary (Burnt Rose) -->
        <item name="colorSecondary">#873D48</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#FCE4E6</item>
        <item name="colorOnSecondaryContainer">#873D48</item>

        <!-- Tertiary (Golden Apricot) -->
        <item name="colorTertiary">#ED9B40</item>
        <item name="colorOnTertiary">#272727</item>
        <item name="colorTertiaryContainer">#FFF3E0</item>
        <item name="colorOnTertiaryContainer">#873D00</item>

        <!-- Neutral / Surface colors (Shadow Grey text, Slate background) -->
        <item name="android:colorBackground">#F8FAFC</item>
        <item name="colorOnBackground">#272727</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#272727</item>
        <item name="colorSurfaceVariant">#F1F5F9</item>
        <item name="colorOnSurfaceVariant">#475569</item>
        <item name="colorOutline">#CBD5E1</item>
        <item name="colorOutlineVariant">#E2E8F0</item>

        <!-- Surface Container variants for M3 -->
        <item name="colorSurfaceContainer">#F1F5F9</item>
        <item name="colorSurfaceContainerLow">#F8FAFC</item>
        <item name="colorSurfaceContainerHigh">#E2E8F0</item>
        <item name="colorSurfaceContainerHighest">#CBD5E1</item>
    </style>

    <style name="Theme.FlightStats" parent="Base.Theme.FlightStats" />
</resources>