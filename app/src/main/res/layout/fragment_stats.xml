<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Horizontal Scrollable Selector of Year Chips -->
        <HorizontalScrollView
            android:id="@+id/scroll_year_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:fillViewport="true"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:clipToPadding="false"
            android:background="?attr/colorSurface">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_years"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true"
                app:selectionRequired="true" />
        </HorizontalScrollView>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_stats_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="96dp"
            android:paddingTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- ═══════════════════════════════════════════
                 CARD 1: HERO OVERVIEW — Squircle, PrimaryContainer
                 Total flights · countries · airports · routes
                 ═══════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_overview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Overview"
                        android:textSize="13sp"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:alpha="0.7"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/stat_flights"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0" android:textSize="36sp" android:textStyle="bold"
                                android:textColor="?attr/colorOnPrimaryContainer"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Flights" android:textSize="12sp"
                                android:textColor="?attr/colorOnPrimaryContainer" android:alpha="0.7"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/stat_countries"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0" android:textSize="36sp" android:textStyle="bold"
                                android:textColor="?attr/colorOnPrimaryContainer"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Countries" android:textSize="12sp"
                                android:textColor="?attr/colorOnPrimaryContainer" android:alpha="0.7"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/stat_airports"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0" android:textSize="36sp" android:textStyle="bold"
                                android:textColor="?attr/colorOnPrimaryContainer"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Airports" android:textSize="12sp"
                                android:textColor="?attr/colorOnPrimaryContainer" android:alpha="0.7"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/stat_routes"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0" android:textSize="36sp" android:textStyle="bold"
                                android:textColor="?attr/colorOnPrimaryContainer"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Routes" android:textSize="12sp"
                                android:textColor="?attr/colorOnPrimaryContainer" android:alpha="0.7"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════════
                 CARD 1.5: TRAVEL STORIES — Diagonal shape, collapsible
                 ═══════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_story_stats"
                style="@style/Widget.Material3.CardView.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:shapeAppearance="@style/ShapeAppearance.FlightStats.Diagonal"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Header: Icon + Year Title -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_book"
                            app:tint="?attr/colorPrimary"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/story_title_stats"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2026 Travel Story"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary" />
                    </LinearLayout>

                    <!-- Collapsible text container -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/story_text_stats"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:lineSpacingMultiplier="1.25"
                            android:textColor="?attr/colorOnSurface"
                            android:fontFamily="serif" />

                        <View
                            android:id="@+id/view_fade_overlay"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_gravity="bottom"
                            android:visibility="gone" />

                    </FrameLayout>

                    <!-- Expand / Collapse Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_expand_story"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="Read Travel Summary"
                        app:icon="@drawable/ic_book"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />

                    <!-- Regenerate Individual Story Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_regenerate_story_individual"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="Generate AI Summary"
                        app:icon="@drawable/ic_book"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════════
                 CARD 2: DISTANCE — Diagonal shape, SecondaryContainer
                 Big km number + miles / circumnavigations
                 ═══════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_distance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSecondaryContainer"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.FlightStats.Diagonal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Distance"
                        android:textSize="13sp"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        android:alpha="0.7"
                        android:layout_marginBottom="4dp"/>

                    <TextView android:id="@+id/stat_km"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 km"
                        android:textSize="44sp"
                        android:textStyle="bold"
                        android:lineSpacingMultiplier="0.9"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:id="@+id/stat_miles"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0 mi" android:textSize="16sp" android:textStyle="bold"
                                android:textColor="?attr/colorOnSecondaryContainer"/>
                            <TextView android:id="@+id/label_miles"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="miles" android:textSize="11sp"
                                android:textColor="?attr/colorOnSecondaryContainer" android:alpha="0.65"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:id="@+id/stat_circumnavigations"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0×" android:textSize="16sp" android:textStyle="bold"
                                android:textColor="?attr/colorOnSecondaryContainer"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="earth circumnavigations" android:textSize="11sp"
                                android:textColor="?attr/colorOnSecondaryContainer" android:alpha="0.65"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:id="@+id/stat_moon"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0%" android:textSize="16sp" android:textStyle="bold"
                                android:textColor="?attr/colorOnSecondaryContainer"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="to the moon" android:textSize="11sp"
                                android:textColor="?attr/colorOnSecondaryContainer" android:alpha="0.65"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════════
                 CARD 3: LONGEST FLIGHT — TopRounded, TertiaryContainer
                 Bold route display
                 ═══════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_longest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorTertiaryContainer"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.FlightStats.TopRounded">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✈ Longest Flight"
                        android:textSize="13sp"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true"
                        android:textColor="?attr/colorOnTertiaryContainer"
                        android:alpha="0.7"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView android:id="@+id/stat_longest_origin"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="—" android:textSize="32sp" android:textStyle="bold"
                            android:textColor="?attr/colorOnTertiaryContainer"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="  →  " android:textSize="20sp"
                            android:textColor="?attr/colorOnTertiaryContainer" android:alpha="0.6"/>
                        <TextView android:id="@+id/stat_longest_dest"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="—" android:textSize="32sp" android:textStyle="bold"
                            android:textColor="?attr/colorOnTertiaryContainer"/>
                    </LinearLayout>

                    <TextView android:id="@+id/stat_longest_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnTertiaryContainer"
                        android:alpha="0.7"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════════
                 CARD 4: TOP AIRPORTS — Standard card, surface
                 ═══════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_top_airports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.FlightStats.Squircle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Top Airports"
                        android:textSize="13sp"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true"
                        android:textColor="?attr/colorOnSurface"
                        android:alpha="0.6"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout android:id="@+id/list_top_airports"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════════
                 CARD 5: FLIGHT PATTERNS CHART — Surface, default ON
                 Switchable: by Month / Day / Year
                 ═══════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_charts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:cardCornerRadius="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="20dp"
                    android:paddingHorizontal="20dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Flight Patterns"
                        android:textSize="13sp"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true"
                        android:textColor="?attr/colorOnSurface"
                        android:alpha="0.6"
                        android:layout_marginBottom="14dp"/>

                    <!-- M3 SegmentedButton style toggle -->
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggle_chart_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_by_month"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Month"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_by_day"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Day"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_by_year"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Year"/>

                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/bar_chart"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TIME ALOFT — default OFF -->
            <!-- TIME ALOFT — default OFF -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorTertiaryContainer"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.FlightStats.Diagonal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⏱  Time Aloft"
                        android:textSize="13sp"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true"
                        android:textColor="?attr/colorOnTertiaryContainer"
                        android:alpha="0.7"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:id="@+id/stat_hours"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0" android:textSize="40sp" android:textStyle="bold"
                                android:textColor="?attr/colorOnTertiaryContainer"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="hours" android:textSize="13sp"
                                android:textColor="?attr/colorOnTertiaryContainer" android:alpha="0.7"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:id="@+id/stat_days"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0" android:textSize="40sp" android:textStyle="bold"
                                android:textColor="?attr/colorOnTertiaryContainer"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="days" android:textSize="13sp"
                                android:textColor="?attr/colorOnTertiaryContainer" android:alpha="0.7"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TOP ROUTES — default OFF -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_top_routes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSecondaryContainer"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.FlightStats.TopRounded">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Top Routes"
                        android:textSize="13sp"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        android:alpha="0.7"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout android:id="@+id/list_top_routes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════════
                 CARD 6: GLOBAL FOOTPRINT — SurfaceContainerHighest
                 Pie chart of countries visited
                 ═══════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_footprint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.example.flightstats.EdgeToEdgePieView
                        android:id="@+id/pie_chart"
                        android:layout_width="match_parent"
                        android:layout_height="220dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    </LinearLayout>



</androidx.coordinatorlayout.widget.CoordinatorLayout>
