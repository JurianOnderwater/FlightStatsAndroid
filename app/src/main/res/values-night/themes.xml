<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.FlightStats" parent="Base.Theme.FlightStats.Common">
        <!-- Customize your dark theme here. -->
        <!-- Primary (Willow Green) -->
        <item name="colorPrimary">#88D18A</item>
        <item name="colorOnPrimary">#272727</item>
        <item name="colorPrimaryContainer">#3D5A3E</item>
        <item name="colorOnPrimaryContainer">#CCDDB7</item>
 
        <!-- Secondary (Burnt Rose) -->
        <item name="colorSecondary">#873D48</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#5A2931</item>
        <item name="colorOnSecondaryContainer">#FCE4E6</item>
 
        <!-- Tertiary (Golden Apricot) -->
        <item name="colorTertiary">#ED9B40</item>
        <item name="colorOnTertiary">#272727</item>
        <item name="colorTertiaryContainer">#874E10</item>
        <item name="colorOnTertiaryContainer">#FFF3E0</item>
 
        <!-- Neutral / Surface colors (Shadow Grey background, light text) -->
        <item name="android:colorBackground">#272727</item>
        <item name="colorOnBackground">#F8FAFC</item>
        <item name="colorSurface">#333333</item>
        <item name="colorOnSurface">#F8FAFC</item>
        <item name="colorSurfaceVariant">#444444</item>
        <item name="colorOnSurfaceVariant">#CBD5E1</item>
        <item name="colorOutline">#555555</item>
        <item name="colorOutlineVariant">#444444</item>
 
        <!-- Surface Container variants for M3 dark mode -->
        <item name="colorSurfaceContainer">#333333</item>
        <item name="colorSurfaceContainerLow">#222222</item>
        <item name="colorSurfaceContainerHigh">#444444</item>
        <item name="colorSurfaceContainerHighest">#555555</item>
    </style>
</resources>